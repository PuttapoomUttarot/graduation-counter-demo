# ─────────────────────────────────────────────────────────────
# Phase 0-1 configuration: Video File + YOLO26 Pose + GPU check
# Later phases (tracking, zones, state machine, Node.js) will
# reuse these same variables plus add their own.
# ─────────────────────────────────────────────────────────────

# Path to the ceremony video file. Later this can become "0" for a
# webcam, or an rtsp:// URL for an IP camera, without changing
# detector.py, app.py, or any downstream logic — only video_source.py
# would gain a new VideoSource implementation.
VIDEO_SOURCE=./data/videos/graduation_demo.mp4

# YOLO26 Pose model weights file. Ultralytics downloads this
# automatically from the official release on first use if it is not
# already present in the working directory.
YOLO_MODEL=yolo26n-pose.pt

# Inference thresholds
YOLO_CONF=0.45
YOLO_IOU=0.50
YOLO_IMGSZ=640

# CUDA device index (e.g. 0), or "cpu" to force CPU inference.
DEVICE=0

LOG_LEVEL=INFO

# Maximum size (pixels) for the on-screen preview window. The video is
# scaled down to fit within this box (aspect ratio preserved); inference
# still runs on the full-resolution frame — this only affects display.
DISPLAY_MAX_WIDTH=1280
DISPLAY_MAX_HEIGHT=720

# ROI zone rectangle, in PIXEL coordinates of the full-resolution video
# frame (not the resized display window — inference and zone-checking
# both run on the original frame). (ZONE_X1, ZONE_Y1) is the top-left
# corner, (ZONE_X2, ZONE_Y2) is the bottom-right corner. This is drawn
# on-screen (green = clear/armed, red = occupied/locked) so you can tune
# it by watching it against your video — position it over the doorway,
# stage step, or handshake point where a recipient's head should pass.
ZONE_X1=480
ZONE_Y1=120
ZONE_X2=800
ZONE_Y2=480

# Head-keypoint confidence threshold. Only COCO keypoints 0-4 (nose,
# left eye, right eye, left ear, right ear) with confidence STRICTLY
# GREATER than this are considered "present" for zone-entry checks.
HEAD_KEYPOINT_CONF=0.5

# Consecutive fully-clear frames required (ALL head keypoints of ALL
# people outside the ROI) before the zone unlocks and can be triggered
# again. Higher = more resistant to flicker/false drops, but slightly
# slower to re-arm for the next recipient. 8-10 is a good starting
# range at typical webcam/video frame rates.
EMPTY_CONFIRM_FRAMES=8
